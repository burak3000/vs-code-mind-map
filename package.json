{
	"name": "mindmap-view",
	"displayName": "Mind Map View",
	"description": "XMind-like mind mapping custom editor for markdown files, with true bidirectional sync.",
	"version": "0.0.1",
	"publisher": "TODO-set-publisher-id",
	"private": true,
	"license": "MIT",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Visualization",
		"Other"
	],
	"main": "./dist/extension.js",
	"activationEvents": [],
	"contributes": {
		"customEditors": [
			{
				"viewType": "mindmapView.editor",
				"displayName": "Mind Map",
				"selector": [
					{
						"filenamePattern": "*.md"
					}
				],
				"priority": "option"
			}
		],
		"commands": [
			{
				"command": "mindmapView.openAsMindMap",
				"title": "Open as Mind Map"
			},
			{
				"command": "mindmapView.undo",
				"title": "Mind Map: Undo"
			},
			{
				"command": "mindmapView.redo",
				"title": "Mind Map: Redo"
			},
			{
				"command": "mindmapView.search",
				"title": "Mind Map: Search"
			},
			{
				"command": "mindmapView.rebalance",
				"title": "Mind Map: Rebalance"
			},
			{
				"command": "mindmapView.linkEditor",
				"title": "Mind Map: Edit Link"
			},
			{
				"command": "mindmapView.toggleFold",
				"title": "Mind Map: Toggle Fold"
			},
			{
				"command": "mindmapView.toggleToText",
				"title": "Mind Map: Switch to Markdown Editor"
			},
			{
				"command": "mindmapView.toggleToMindMap",
				"title": "Mind Map: Switch to Mind Map Editor"
			}
		],
		"keybindings": [
			{
				"command": "mindmapView.undo",
				"key": "ctrl+z",
				"mac": "cmd+z",
				"when": "activeCustomEditorId == 'mindmapView.editor'"
			},
			{
				"command": "mindmapView.redo",
				"key": "ctrl+shift+z",
				"mac": "cmd+shift+z",
				"when": "activeCustomEditorId == 'mindmapView.editor'"
			},
			{
				"command": "mindmapView.redo",
				"key": "ctrl+y",
				"when": "activeCustomEditorId == 'mindmapView.editor'"
			},
			{
				"command": "mindmapView.search",
				"key": "ctrl+f",
				"mac": "cmd+f",
				"when": "activeCustomEditorId == 'mindmapView.editor'"
			},
			{
				"command": "mindmapView.rebalance",
				"key": "ctrl+shift+b",
				"mac": "cmd+shift+b",
				"when": "activeCustomEditorId == 'mindmapView.editor'"
			},
			{
				"command": "mindmapView.linkEditor",
				"key": "ctrl+k",
				"mac": "cmd+k",
				"when": "activeCustomEditorId == 'mindmapView.editor'"
			},
			{
				"command": "mindmapView.toggleFold",
				"key": "ctrl+/",
				"mac": "cmd+/",
				"when": "activeCustomEditorId == 'mindmapView.editor'"
			},
			{
				"command": "mindmapView.toggleToText",
				"key": "ctrl+m",
				"mac": "cmd+m",
				"when": "activeCustomEditorId == 'mindmapView.editor'"
			},
			{
				"command": "mindmapView.toggleToMindMap",
				"key": "ctrl+m",
				"mac": "cmd+m",
				"when": "editorTextFocus && editorLangId == 'markdown'"
			}
		]
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -p tsconfig.json && tsc -noEmit -p tsconfig.webview.json && node esbuild.config.mjs production",
		"fixtures": "node scripts/generate-fixtures.mjs",
		"bench:m1": "node scripts/bench-m1.mjs",
		"bench:open": "node scripts/bench-open.mjs",
		"bench:m2": "node scripts/bench-m2.mjs",
		"bench:images": "node scripts/bench-images.mjs",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"@types/vscode": "^1.85.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.28.1",
		"jsdom": "^29.1.1",
		"typescript": "^5.3.3",
		"vitest": "^3.2.5"
	},
	"dependencies": {
		"d3-flextree": "^2.1.2"
	}
}
