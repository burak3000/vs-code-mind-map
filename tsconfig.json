{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "CommonJS",
		"target": "ES2020",
		"lib": ["ES2020"],
		"moduleResolution": "node",
		"esModuleInterop": true,
		"strict": true,
		"noImplicitAny": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"inlineSourceMap": true,
		"inlineSources": true
	},
	"include": ["src/**/*.ts"]
}
